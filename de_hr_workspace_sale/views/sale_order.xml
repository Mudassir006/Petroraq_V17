<?xml version="1.0" encoding="UTF-8" ?>

<odoo>
    <record id="pr_sale_workflow_sale_order_manager_action" model="ir.actions.act_window">
        <field name="name">Sale Quotations - Manager</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('approval_state','=','to_manager')]</field>
        <field name="context">{'create':False,'edit':False}</field>
        <field name="search_view_id" ref="sale.sale_order_view_search_inherit_quotation"/>
    </record>

    <record id="pr_sale_workflow_sale_order_action" model="ir.actions.act_window">
        <field name="name">Sale Quotations - MD</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('approval_state','=','to_md')]</field>
        <field name="context">{'create':False,'edit':False}</field>
        <field name="search_view_id" ref="sale.sale_order_view_search_inherit_quotation"/>
    </record>

    <record id="pr_sale_order_inquiry_manager_action" model="ir.actions.act_window">
        <field name="name">Order Inquiries</field>
        <field name="res_model">order.inq</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state','=','confirm')]</field>
        <field name="context">{'create':False,'edit':False}</field>
    </record>

    <menuitem id="sale_order_manager_approvals_view_menu"
              parent="menu_sales_manager_approvals"
              name="Sale Quotations"
              action="pr_sale_workflow_sale_order_manager_action"
              groups="petroraq_sale_workflow.group_sale_approval_manager"
              sequence="1"/>

    <menuitem id="sale_order_approvals_view_menu"
              parent="menu_sales_md_approvals"
              name="Sale Quotations"
              action="pr_sale_workflow_sale_order_action"
              groups="petroraq_sale_workflow.group_sale_approval_md"
              sequence="1"/>

    <menuitem id="sale_order_inquiry_manager_approvals_view_menu"
              parent="menu_sales_manager_approvals"
              name="Order Inquiries"
              action="pr_sale_order_inquiry_manager_action"
              groups="sales_team.group_sale_manager"
              sequence="2"/>

</odoo>
