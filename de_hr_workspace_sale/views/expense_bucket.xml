<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="pr_sale_expense_bucket_department_manager_approvals_action" model="ir.actions.act_window">
        <field name="name">Expense Buckets (Department Manager)</field>
        <field name="res_model">pr.expense.bucket</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '=', 'pm_approval'), ('scope', '=', 'department'), ('department_id.manager_id.user_id', '=', uid)]</field>
        <field name="context">{'create': False, 'edit': False}</field>
    </record>

    <record id="pr_sale_expense_bucket_pm_approvals_action" model="ir.actions.act_window">
        <field name="name">Expense Buckets (Project Manager)</field>
        <field name="res_model">pr.expense.bucket</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '=', 'pm_approval'), ('scope', '=', 'project')]</field>
        <field name="context">{'create': False, 'edit': False}</field>
    </record>

    <record id="pr_sale_expense_bucket_accounts_approvals_action" model="ir.actions.act_window">
        <field name="name">Expense Buckets (Accounts)</field>
        <field name="res_model">pr.expense.bucket</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '=', 'accounts_approval')]</field>
        <field name="context">{'create': False, 'edit': False}</field>
    </record>

    <record id="pr_sale_expense_bucket_md_approvals_action" model="ir.actions.act_window">
        <field name="name">Expense Buckets (MD)</field>
        <field name="res_model">pr.expense.bucket</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '=', 'md_approval')]</field>
        <field name="context">{'create': False, 'edit': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No expense buckets are pending MD approval.
            </p>
        </field>
    </record>

    <menuitem id="expense_bucket_department_manager_approvals_view_menu"
              parent="menu_my_purchase_approvals"
              name="Expense Buckets"
              action="pr_sale_expense_bucket_department_manager_approvals_action"
              sequence="6"
              groups="base.group_user"/>

    <menuitem id="expense_bucket_pm_approvals_view_menu"
              parent="menu_my_purchase_approvals"
              name="Expense Buckets"
              action="pr_sale_expense_bucket_pm_approvals_action"
              sequence="7"
              groups="pr_custom_purchase.project_manager"/>

    <menuitem id="expense_bucket_accounts_approvals_view_menu"
              parent="menu_my_purchase_approvals"
              name="Expense Buckets"
              action="pr_sale_expense_bucket_accounts_approvals_action"
              sequence="8"
              groups="account.group_account_manager,account.group_account_user"/>

    <menuitem id="expense_bucket_md_approvals_view_menu"
              parent="menu_my_purchase_approvals"
              name="Expense Buckets"
              action="pr_sale_expense_bucket_md_approvals_action"
              sequence="9"
              groups="pr_custom_purchase.managing_director"/>
</odoo>
