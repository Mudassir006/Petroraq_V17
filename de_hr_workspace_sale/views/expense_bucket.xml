<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="pr_sale_expense_bucket_approvals_action" model="ir.actions.act_window">
        <field name="name">Expense Buckets</field>
        <field name="res_model">pr.expense.bucket</field>
        <field name="view_mode">list,form</field>
        <field name="domain">['|', '|', '|',
            '&amp;', ('state', '=', 'pm_approval'), ('department_id.manager_id.user_id', '=', uid),
            '&amp;', ('state', '=', 'pm_approval'), ('scope', '=', 'project'),
            ('state', '=', 'accounts_approval'),
            ('state', '=', 'md_approval')
        ]</field>
        <field name="context">{'create': False, 'edit': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No expense buckets are pending your approval.
            </p>
        </field>
    </record>

    <menuitem id="expense_bucket_approvals_view_menu"
              parent="menu_my_purchase_approvals"
              name="Expense Buckets"
              action="pr_sale_expense_bucket_approvals_action"
              sequence="6"
              groups="base.group_user"/>
</odoo>
