<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_workspace_advanced_leave_dashboard" model="ir.actions.act_window">
        <field name="name">Leave Dashboard</field>
        <field name="res_model">hr.leave</field>
        <field name="view_mode">calendar,tree,form,activity</field>
        <field name="view_id" ref="hr_holidays.hr_leave_view_dashboard"/>
        <field name="search_view_id" ref="hr_holidays.hr_leave_view_search_manager"/>
        <field name="domain">[]</field>
        <field name="context">{'short_name': 1, 'search_default_active_time_off': 1, 'show_all_leave_dashboard': True}</field>
    </record>

    <menuitem id="menu_workspace_leave_management_root"
              name="Leave Management"
              parent="de_hr_workspace.menu_my_employee_approvals"
              sequence="25"
              groups="hr.group_hr_manager,de_hr_workspace.group_hr_employee_approvals"/>

    <menuitem id="menu_workspace_advanced_leave_dashboard"
              name="Leave Dashboard"
              parent="menu_workspace_leave_management_root"
              action="action_workspace_advanced_leave_dashboard"
              sequence="5"
              groups="hr.group_hr_manager,de_hr_workspace.group_hr_employee_approvals"/>
</odoo>
