<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- PDF Report Action -->
    <record id="vat_summary_pdf_report" model="ir.actions.report">
        <field name="name">VAT Summary</field>
        <field name="model">vat.summary.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">pr_vat_summary.vat_summary_pdf_template</field>
        <field name="report_file">pr_vat_summary.vat_summary_pdf_template</field>
        <!-- Safe python expression: dates → strftime -->
        <field name="print_report_name">
            'VAT Summary - %s to %s' % (
            object.date_start and object.date_start.strftime('%Y-%m-%d') or '',
            object.date_end and object.date_end.strftime('%Y-%m-%d') or ''
            )
        </field>
    </record>


    <!-- QWeb PDF Template -->
    <template id="vat_summary_pdf_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="wizard">
                <t t-set="company" t-value="wizard.company_id"/>

                <!-- Compute the same helper values as HTML -->
                <t t-set="sales_vat_abs"
                   t-value="wizard.sales_vat if wizard.sales_vat &gt;= 0.0 else -wizard.sales_vat"/>
                <t t-set="pur_vat_abs"
                   t-value="wizard.vated_purchases_vat if wizard.vated_purchases_vat &gt;= 0.0 else -wizard.vated_purchases_vat"/>

                <t t-set="vated_sales_total" t-value="wizard.sales_amount + sales_vat_abs"/>
                <t t-set="non_vated_sales_total" t-value="wizard.non_vated_sales_amount"/>
                <t t-set="sales_total_amount" t-value="wizard.sales_amount + wizard.non_vated_sales_amount"/>
                <t t-set="sales_total_vat" t-value="sales_vat_abs"/>
                <t t-set="sales_total" t-value="vated_sales_total + non_vated_sales_total"/>
                <t t-set="vated_pur_total" t-value="wizard.vated_purchases_amount + pur_vat_abs"/>
                <t t-set="non_vated_total" t-value="wizard.non_vated_purchases_amount"/>
                <t t-set="purchase_total_amount" t-value="wizard.vated_purchases_amount + wizard.non_vated_purchases_amount"/>
                <t t-set="purchase_total_vat" t-value="pur_vat_abs"/>
                <t t-set="purchase_total" t-value="vated_pur_total + non_vated_total"/>

                <!-- Need to deposit row (vated sales - vated purchases) -->
                <t t-set="deposit_amount" t-value="wizard.sales_amount - wizard.vated_purchases_amount"/>
                <t t-set="deposit_vat" t-value="sales_vat_abs - pur_vat_abs"/>
                <t t-set="deposit_total" t-value="vated_sales_total - vated_pur_total"/>

                <div class="page">
                    <style>
                        table.vat-summary {
                        width: 100%;
                        border-collapse: collapse;
                        font-size: 15px;
                        margin-top: 15px;
                        }
                        table.vat-summary th {
                        background-color: #29608f;
                        color: white;
                        padding: 10px;
                        border: 2px solid #000000;
                        font-weight: bold;
                        text-align: center;
                        }
                        table.vat-summary td {
                        padding: 10px;
                        border: 1.8px solid #000000;
                        text-align: center;
                        vertical-align: middle;
                        }
                        table.vat-summary td.desc {
                        text-align: left;
                        font-weight: 500;
                        }
                        .section-title td {
                        background-color: #f5f5f5;
                        font-weight: bold;
                        border-top: 2px solid #000000;
                        border-bottom: 2px solid #000000;
                        }
                        .vat-title {
                        text-align: center;
                        font-size: 24px;
                        font-weight: bold;
                        margin-bottom: 2px;
                        color: #fff;
                        background-color: #1F497D;
                        border: 1px solid #000;
                        padding: 6px;
                        }
                        .vat-period {
                        text-align: center;
                        margin-bottom: 2px;
                        font-size: 22px;
                        color: #fff;
                        background-color: #1F497D;
                        border: 1px solid #000;
                        padding: 6px;
                        font-weight: bold;
                        }
                        .vat-company {
                        text-align: center;
                        margin-bottom: 2px;
                        font-size: 18px;
                        color: #fff;
                        background-color: #1F497D;
                        border: 1px solid #000;
                        padding: 6px;
                        font-weight: bold;
                        }
                        .detail-section {
                        background-color: #f5f5f5;
                        font-weight: bold;
                        }
                    </style>

                    <!-- Header (same idea as HTML title) -->
                    <div class="vat-company">
                        <t t-esc="company.name"/>
                        - VAT Number
                        <t t-esc="company.vat or ''"/>
                    </div>
                    <div class="vat-title">
                        Statement of VAT Summary
                    </div>
                    <div class="vat-period">
                        Period:
                        <t t-esc="wizard.date_start.strftime('%d-%b-%Y')"/>
                        to
                        <t t-esc="wizard.date_end.strftime('%d-%b-%Y')"/>
                    </div>
                    <div class="vat-title" style="margin-top: 8px;">
                        <t t-esc="company.name"/>
                        - VAT Summary
                    </div>

                    <!-- TABLE: same structure as HTML -->
                    <table class="vat-summary">
                        <!-- Title row -->
                        <tr>
                            <th colspan="5">
                                VAT Report
                                <t t-esc="wizard.date_start"/>
                                to
                                <t t-esc="wizard.date_end"/>
                            </th>
                        </tr>

                        <!-- Header row -->
                        <tr>
                            <th>Sr. No</th>
                            <th>Description</th>
                            <th>Amount</th>
                            <th>VAT 15%</th>
                            <th>Total</th>
                        </tr>

                        <!-- SALES SECTION -->
                        <tr class="section-title">
                            <td>1</td>
                            <td class="desc">
                                <b>Sales:</b>
                            </td>
                            <td></td>
                            <td></td>
                            <td></td>
                        </tr>

                        <tr>
                            <td>i</td>
                            <td class="desc">Sales Revenue / Income Vated</td>
                            <td>
                                <t t-esc="'{:,.2f}'.format(wizard.sales_amount or 0.0)"/>
                            </td>
                            <!-- VAT should always display positive -->
                            <td>
                                <t t-esc="'{:,.2f}'.format(sales_vat_abs or 0.0)"/>
                            </td>
                            <td>
                                <t t-esc="'{:,.2f}'.format(vated_sales_total or 0.0)"/>
                            </td>
                        </tr>

                        <tr>
                            <td>ii</td>
                            <td class="desc">Sales Revenue / Income Non Vated</td>
                            <td>
                                <t t-esc="'{:,.2f}'.format(wizard.non_vated_sales_amount or 0.0)"/>
                            </td>
                            <td>-</td>
                            <td>
                                <t t-esc="'{:,.2f}'.format(non_vated_sales_total or 0.0)"/>
                            </td>
                        </tr>

                        <tr class="section-title">
                            <td colspan="2" class="desc" style="text-align:right;">
                                <b>Total Sales Revenue / Income</b>
                            </td>
                            <td>
                                <b>
                                    <t t-esc="'{:,.2f}'.format(sales_total_amount or 0.0)"/>
                                </b>
                            </td>
                            <td>
                                <b>
                                    <t t-esc="'{:,.2f}'.format(sales_total_vat or 0.0)"/>
                                </b>
                            </td>
                            <td>
                                <b>
                                    <t t-esc="'{:,.2f}'.format(sales_total or 0.0)"/>
                                </b>
                            </td>
                        </tr>

                        <!-- PURCHASES SECTION -->
                        <tr class="section-title">
                            <td>2</td>
                            <td class="desc">
                                <b>Purchases :</b>
                            </td>
                            <td></td>
                            <td></td>
                            <td></td>
                        </tr>

                        <tr>
                            <td>i</td>
                            <td class="desc">Vated Purchase/Expenses</td>
                            <td>
                                <t t-esc="'{:,.2f}'.format(wizard.vated_purchases_amount or 0.0)"/>
                            </td>
                            <!-- VAT should always display positive -->
                            <td>
                                <t t-esc="'{:,.2f}'.format(pur_vat_abs or 0.0)"/>
                            </td>
                            <td>
                                <t t-esc="'{:,.2f}'.format(vated_pur_total or 0.0)"/>
                            </td>
                        </tr>

                        <tr>
                            <td>ii</td>
                            <td class="desc">Non Vated Purchase/Expenses</td>
                            <td>
                                <t t-esc="'{:,.2f}'.format(wizard.non_vated_purchases_amount or 0.0)"/>
                            </td>
                            <td>-</td>
                            <td>
                                <t t-esc="'{:,.2f}'.format(non_vated_total or 0.0)"/>
                            </td>
                        </tr>

                        <!-- PURCHASE TOTAL ROW -->
                        <tr class="section-title">
                            <td colspan="2" class="desc" style="text-align:right;">
                                <b>Total Purchases / Expenses</b>
                            </td>
                            <td>
                                <b>
                                    <t t-esc="'{:,.2f}'.format(purchase_total_amount or 0.0)"/>
                                </b>
                            </td>
                            <td>
                                <b>
                                    <t t-esc="'{:,.2f}'.format(purchase_total_vat or 0.0)"/>
                                </b>
                            </td>
                            <td>
                                <b>
                                    <t t-esc="'{:,.2f}'.format(purchase_total or 0.0)"/>
                                </b>
                            </td>
                        </tr>

                        <tr class="section-title">
                            <td colspan="2" class="desc" style="text-align:center;">
                                <b>Need to Deposit GOV VAT</b>
                            </td>
                            <td>
                                <b>
                                    <t t-esc="'{:,.2f}'.format(deposit_amount or 0.0)"/>
                                </b>
                            </td>
                            <td>
                                <b>
                                    <t t-esc="'{:,.2f}'.format(deposit_vat or 0.0)"/>
                                </b>
                            </td>
                            <td>
                                <b>
                                    <t t-esc="'{:,.2f}'.format(deposit_total or 0.0)"/>
                                </b>
                            </td>
                        </tr>
                    </table>

                    <t t-if="wizard.is_detailed">
                        <t t-set="details" t-value="wizard._prepare_detailed_lines()"/>
                        <table class="vat-summary" style="margin-top:12px;">
                            <tr>
                                <th colspan="7">Detailed Transactions</th>
                            </tr>
                            <tr>
                                <th>Journal Entry</th>
                                <th>Reference</th>
                                <th>Date</th>
                                <th>Description</th>
                                <th>Amount</th>
                                <th>VAT Amount</th>
                                <th>Total Amount</th>
                            </tr>

                            <tr class="detail-section">
                                <td colspan="7">Vated - Sales / Revenue</td>
                            </tr>
                            <t t-set="vated_sales_amount_total" t-value="sum(l['amount'] for l in details['vated_sales'])"/>
                            <t t-set="vated_sales_vat_total" t-value="sum(l['vat_amount'] for l in details['vated_sales'])"/>
                            <t t-set="vated_sales_grand_total" t-value="sum(l['total_amount'] for l in details['vated_sales'])"/>
                            <t t-if="not details['vated_sales']">
                                <tr>
                                    <td colspan="7">No lines</td>
                                </tr>
                            </t>
                            <t t-foreach="details['vated_sales']" t-as="line">
                                <tr>
                                    <td><t t-esc="line['entry']"/></td>
                                    <td><t t-esc="line['reference']"/></td>
                                    <td><t t-esc="line['date']"/></td>
                                    <td class="desc"><t t-esc="line['label']"/></td>
                                    <td><t t-esc="'{:,.2f}'.format(line['amount'])"/></td>
                                    <td><t t-esc="'{:,.2f}'.format(line['vat_amount'])"/></td>
                                    <td><t t-esc="'{:,.2f}'.format(line['total_amount'])"/></td>
                                </tr>
                            </t>
                            <tr class="detail-section">
                                <td colspan="4" style="text-align:right;">Section Total</td>
                                <td><t t-esc="'{:,.2f}'.format(vated_sales_amount_total)"/></td>
                                <td><t t-esc="'{:,.2f}'.format(vated_sales_vat_total)"/></td>
                                <td><t t-esc="'{:,.2f}'.format(vated_sales_grand_total)"/></td>
                            </tr>

                            <tr class="detail-section">
                                <td colspan="7">Non-Vated - Sales / Revenue</td>
                            </tr>
                            <t t-set="non_vated_sales_amount_total" t-value="sum(l['amount'] for l in details['non_vated_sales'])"/>
                            <t t-set="non_vated_sales_vat_total" t-value="sum(l['vat_amount'] for l in details['non_vated_sales'])"/>
                            <t t-set="non_vated_sales_grand_total" t-value="sum(l['total_amount'] for l in details['non_vated_sales'])"/>
                            <t t-if="not details['non_vated_sales']">
                                <tr>
                                    <td colspan="7">No lines</td>
                                </tr>
                            </t>
                            <t t-foreach="details['non_vated_sales']" t-as="line">
                                <tr>
                                    <td><t t-esc="line['entry']"/></td>
                                    <td><t t-esc="line['reference']"/></td>
                                    <td><t t-esc="line['date']"/></td>
                                    <td class="desc"><t t-esc="line['label']"/></td>
                                    <td><t t-esc="'{:,.2f}'.format(line['amount'])"/></td>
                                    <td><t t-esc="'{:,.2f}'.format(line['vat_amount'])"/></td>
                                    <td><t t-esc="'{:,.2f}'.format(line['total_amount'])"/></td>
                                </tr>
                            </t>
                            <tr class="detail-section">
                                <td colspan="4" style="text-align:right;">Section Total</td>
                                <td><t t-esc="'{:,.2f}'.format(non_vated_sales_amount_total)"/></td>
                                <td><t t-esc="'{:,.2f}'.format(non_vated_sales_vat_total)"/></td>
                                <td><t t-esc="'{:,.2f}'.format(non_vated_sales_grand_total)"/></td>
                            </tr>

                            <tr class="detail-section">
                                <td colspan="7">Vated - Purchases / Expenses</td>
                            </tr>
                            <t t-set="vated_purchases_amount_total" t-value="sum(l['amount'] for l in details['vated_purchases'])"/>
                            <t t-set="vated_purchases_vat_total" t-value="sum(l['vat_amount'] for l in details['vated_purchases'])"/>
                            <t t-set="vated_purchases_grand_total" t-value="sum(l['total_amount'] for l in details['vated_purchases'])"/>
                            <t t-if="not details['vated_purchases']">
                                <tr>
                                    <td colspan="7">No lines</td>
                                </tr>
                            </t>
                            <t t-foreach="details['vated_purchases']" t-as="line">
                                <tr>
                                    <td><t t-esc="line['entry']"/></td>
                                    <td><t t-esc="line['reference']"/></td>
                                    <td><t t-esc="line['date']"/></td>
                                    <td class="desc"><t t-esc="line['label']"/></td>
                                    <td><t t-esc="'{:,.2f}'.format(line['amount'])"/></td>
                                    <td><t t-esc="'{:,.2f}'.format(line['vat_amount'])"/></td>
                                    <td><t t-esc="'{:,.2f}'.format(line['total_amount'])"/></td>
                                </tr>
                            </t>
                            <tr class="detail-section">
                                <td colspan="4" style="text-align:right;">Section Total</td>
                                <td><t t-esc="'{:,.2f}'.format(vated_purchases_amount_total)"/></td>
                                <td><t t-esc="'{:,.2f}'.format(vated_purchases_vat_total)"/></td>
                                <td><t t-esc="'{:,.2f}'.format(vated_purchases_grand_total)"/></td>
                            </tr>

                            <tr class="detail-section">
                                <td colspan="7">Non-Vated - Purchases / Expenses</td>
                            </tr>
                            <t t-set="non_vated_purchases_amount_total" t-value="sum(l['amount'] for l in details['non_vated_purchases'])"/>
                            <t t-set="non_vated_purchases_vat_total" t-value="sum(l['vat_amount'] for l in details['non_vated_purchases'])"/>
                            <t t-set="non_vated_purchases_grand_total" t-value="sum(l['total_amount'] for l in details['non_vated_purchases'])"/>
                            <t t-if="not details['non_vated_purchases']">
                                <tr>
                                    <td colspan="7">No lines</td>
                                </tr>
                            </t>
                            <t t-foreach="details['non_vated_purchases']" t-as="line">
                                <tr>
                                    <td><t t-esc="line['entry']"/></td>
                                    <td><t t-esc="line['reference']"/></td>
                                    <td><t t-esc="line['date']"/></td>
                                    <td class="desc"><t t-esc="line['label']"/></td>
                                    <td><t t-esc="'{:,.2f}'.format(line['amount'])"/></td>
                                    <td><t t-esc="'{:,.2f}'.format(line['vat_amount'])"/></td>
                                    <td><t t-esc="'{:,.2f}'.format(line['total_amount'])"/></td>
                                </tr>
                            </t>
                            <tr class="detail-section">
                                <td colspan="4" style="text-align:right;">Section Total</td>
                                <td><t t-esc="'{:,.2f}'.format(non_vated_purchases_amount_total)"/></td>
                                <td><t t-esc="'{:,.2f}'.format(non_vated_purchases_vat_total)"/></td>
                                <td><t t-esc="'{:,.2f}'.format(non_vated_purchases_grand_total)"/></td>
                            </tr>

                            <t t-set="all_lines" t-value="details['vated_sales'] + details['non_vated_sales'] + details['vated_purchases'] + details['non_vated_purchases']"/>
                            <tr class="section-title">
                                <td colspan="4" class="desc" style="text-align:center;">
                                    <b>Total</b>
                                </td>
                                <td>
                                    <b>
                                        <t t-esc="'{:,.2f}'.format(sum(l['amount'] for l in all_lines) if all_lines else 0.0)"/>
                                    </b>
                                </td>
                                <td>
                                    <b>
                                        <t t-esc="'{:,.2f}'.format(sum(l['vat_amount'] for l in all_lines) if all_lines else 0.0)"/>
                                    </b>
                                </td>
                                <td>
                                    <b>
                                        <t t-esc="'{:,.2f}'.format(sum(l['total_amount'] for l in all_lines) if all_lines else 0.0)"/>
                                    </b>
                                </td>
                            </tr>
                        </table>
                    </t>
                </div>
            </t>
        </t>
    </template>

    <!-- XLSX Report -->
    <report
            id="vat_summary_xlsx_report"
            model="vat.summary.wizard"
            string="VAT Summary XLSX"
            report_type="xlsx"
            name="pr_vat_summary.vat_summary_xlsx"
            file="vat_summary_xlsx"
    />

</odoo>