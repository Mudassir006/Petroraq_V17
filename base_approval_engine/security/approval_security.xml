<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_approval_engine_user" model="res.groups">
        <field name="name">Approval Engine User</field>
        <field name="category_id" ref="base.module_category_hidden"/>
    </record>

    <record id="group_approval_engine_admin" model="res.groups">
        <field name="name">Approval Engine Administrator</field>
        <field name="category_id" ref="base.module_category_hidden"/>
        <field name="implied_ids" eval="[(4, ref('base_approval_engine.group_approval_engine_user'))]"/>
    </record>

    <record id="approval_request_user_rule" model="ir.rule">
        <field name="name">Approval Request - participants</field>
        <field name="model_id" ref="model_approval_request"/>
        <field name="groups" eval="[(4, ref('base_approval_engine.group_approval_engine_user'))]"/>
        <field name="domain_force">[
            '|',
            ('requested_by', '=', user.id),
            ('line_ids.approver_id', '=', user.id)
        ]</field>
    </record>

    <record id="approval_request_line_user_rule" model="ir.rule">
        <field name="name">Approval Request Line - own lines</field>
        <field name="model_id" ref="model_approval_request_line"/>
        <field name="groups" eval="[(4, ref('base_approval_engine.group_approval_engine_user'))]"/>
        <field name="domain_force">[
            ('approver_id', '=', user.id)
        ]</field>
    </record>


    <record id="access_approval_enforcement_rule_admin_xml" model="ir.model.access">
        <field name="name">approval.enforcement.rule admin xml</field>
        <field name="model_id" search="[('model', '=', 'approval.enforcement.rule')]"/>
        <field name="group_id" ref="base_approval_engine.group_approval_engine_admin"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="1"/>
        <field name="perm_unlink" eval="1"/>
    </record>

</odoo>
