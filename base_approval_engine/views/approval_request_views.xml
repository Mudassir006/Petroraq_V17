<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_approval_request_tree" model="ir.ui.view">
        <field name="name">approval.request.tree</field>
        <field name="model">approval.request</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="state"/>
                <field name="workflow_id"/>
                <field name="requested_by"/>
                <field name="requested_date"/>
                <field name="current_sequence"/>
                <field name="final_approved_by"/>
            </tree>
        </field>
    </record>

    <record id="view_approval_request_form" model="ir.ui.view">
        <field name="name">approval.request.form</field>
        <field name="model">approval.request</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit" string="Submit" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state in ('cancelled','approved','rejected')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,pending,approved,rejected,cancelled"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="workflow_id" readonly="1"/>
                            <field name="resource_ref" readonly="1"/>
                            <field name="company_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="requested_by" readonly="1"/>
                            <field name="requested_date" readonly="1"/>
                            <field name="current_sequence" readonly="1"/>
                            <field name="final_approved_by" readonly="1"/>
                            <field name="final_approved_date" readonly="1"/>
                        </group>
                    </group>
                    <field name="rejection_reason" readonly="1" invisible="not rejection_reason"/>
                    <notebook>
                        <page string="Approvers">
                            <field name="line_ids" readonly="1">
                                <tree>
                                    <field name="sequence"/>
                                    <field name="approver_id"/>
                                    <field name="status"/>
                                    <field name="required"/>
                                    <field name="source_type"/>
                                    <field name="action_date"/>
                                    <field name="comment"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Chatter">
                            <field name="message_follower_ids"/>
                            <field name="activity_ids"/>
                            <field name="message_ids"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_approval_request" model="ir.actions.act_window">
        <field name="name">Approval Requests</field>
        <field name="res_model">approval.request</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
