<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_approval_reject_wizard_form" model="ir.ui.view">
        <field name="name">approval.reject.wizard.form</field>
        <field name="model">approval.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject Approval">
                <group>
                    <field name="reason" placeholder="Reason for rejection"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Reject" class="btn-danger"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
