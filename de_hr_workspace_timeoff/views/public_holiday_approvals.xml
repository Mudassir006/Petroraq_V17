<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="de_hr_workspace_public_holiday_approvals_action" model="ir.actions.act_window">
        <field name="name">Public Holiday Approvals</field>
        <field name="res_model">resource.calendar.leaves</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('resource_id', '=', False), ('approval_state', 'in', ['to_approve'])]</field>
        <field name="context">{'search_default_group_by_calendar_id': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No public holidays are pending approval.
            </p>
        </field>
    </record>

    <menuitem id="de_hr_workspace_public_holiday_approvals_menu"
              name="Public Holidays"
              parent="de_hr_workspace.hr_approvals_menu_root"
              action="de_hr_workspace_public_holiday_approvals_action"
              sequence="40"
              groups="hr.group_hr_manager"/>
</odoo>
