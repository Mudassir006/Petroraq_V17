<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <record id="seq_sale_quotation" model="ir.sequence">
        <field name="name">Sales Quotation</field>
        <field name="code">sale.quotation</field>
        <field name="prefix">PEC-%(year)s-SQ-</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_sale_order" model="ir.sequence">
        <field name="name">Sales Order</field>
        <field name="code">sale.order</field>
        <field name="implementation">standard</field>
        <field name="active">True</field>

        <field name="prefix">PEC-%(year)s-SO-</field>
        <field name="padding">5</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>

        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_purchase_quotation" model="ir.sequence">
        <field name="name">Request for Quotation</field>
        <field name="code">purchase.quotation</field>
        <field name="prefix">PEC-RFQ-%(year)s/</field>
        <field name="padding">5</field>
        <field name="implementation">no_gap</field>

        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_purchase_order_custom" model="ir.sequence">
        <field name="name">Purchase Order Custom</field>
        <field name="code">purchase.custom.order</field>
        <field name="prefix">PEC-PO-%(year)s/</field>
        <field name="implementation">no_gap</field>

        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
