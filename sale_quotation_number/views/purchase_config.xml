<?xml version="1.0" encoding="utf-8" ?>

<odoo>
    <record id="res_config_settings_view_form_purchase_quotation_number" model="ir.ui.view">
        <field name="name">Purchase quotation number configuration</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="purchase.res_config_settings_view_form_purchase"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='po_lock_confirmed_orders']" position="after">
                <setting id="set_keep_name_po">
                    <field name="keep_name_po" readonly="0"/>
                    <div class="text-muted">
                        If this is unchecked, RFQs use a different sequence from purchase orders
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
