<odoo>
    <record id="email_template_custom_purchase_rfq" model="mail.template">
        <field name="name">Custom RFQ: Send by Email</field>
        <field name="model_id" ref="pr_custom_purchase.model_custom_purchase_rfq"/>
        <field name="subject">RFQ ${object.name or ''}</field>
        <field name="email_from">${(user.email_formatted or user.company_id.email_formatted or '')}</field>
        <field name="partner_to">${object.partner_id.id}</field>
        <field name="lang">${object.partner_id.lang or user.lang}</field>
        <field name="body_html" type="html">
            <div>
                <p>Dear <t t-out="object.partner_id.name or ''"/>,</p>
                <p>
                    Please find attached RFQ <strong><t t-out="object.name or ''"/></strong>
                    for your review and quotation.
                </p>
                <p>
                    <strong>PR Number:</strong> <t t-out="object.pr_name or ''"/><br/>
                    <strong>Order Deadline:</strong> <t t-out="object.date_order or ''"/><br/>
                    <strong>Expected Arrival:</strong> <t t-out="object.date_planned or ''"/>
                </p>
                <p>Regards,<br/><t t-out="user.name"/></p>
            </div>
        </field>
        <field name="auto_delete" eval="True"/>
    </record>
</odoo>
