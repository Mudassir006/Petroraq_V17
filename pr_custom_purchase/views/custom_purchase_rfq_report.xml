<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="action_report_custom_purchase_rfq" model="ir.actions.report">
        <field name="name">Custom RFQ</field>
        <field name="model">custom.purchase.rfq</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">pr_custom_purchase.report_custom_purchase_rfq</field>
        <field name="report_file">pr_custom_purchase.report_custom_purchase_rfq</field>
        <field name="print_report_name">'RFQ_' + (object.name or '')</field>
        <field name="binding_model_id" ref="pr_custom_purchase.model_custom_purchase_rfq"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_custom_purchase_rfq">
        <t t-call="web.external_layout">
            <main>
                <t t-foreach="docs" t-as="o">
                    <div class="page">
                        <h2>Request for Quotation</h2>
                        <p><strong>RFQ:</strong> <span t-esc="o.name"/></p>
                        <p><strong>Vendor:</strong> <span t-esc="o.partner_id.display_name or ''"/></p>
                        <p><strong>PR Number:</strong> <span t-esc="o.pr_name or ''"/></p>
                        <p><strong>Expected Arrival:</strong> <span t-esc="o.date_planned or ''"/></p>

                        <table class="table table-sm table-bordered" style="width:100%; border-collapse:collapse;">
                            <thead>
                                <tr>
                                    <th>Description</th>
                                    <th>Type</th>
                                    <th>Cost Center</th>
                                    <th class="text-end">Quantity</th>
                                    <th>Unit</th>
                                    <th class="text-end">Estimated Unit Price</th>
                                    <th class="text-end">Subtotal</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="o.line_ids" t-as="l">
                                    <td><span t-esc="l.name"/></td>
                                    <td><span t-esc="l.type"/></td>
                                    <td><span t-esc="l.cost_center_id.display_name or ''"/></td>
                                    <td class="text-end"><span t-esc="l.quantity"/></td>
                                    <td><span t-esc="l.unit"/></td>
                                    <td class="text-end"><span t-esc="l.price_unit"/></td>
                                    <td class="text-end"><span t-esc="l.subtotal"/></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </t>
            </main>
        </t>
    </template>
</odoo>
