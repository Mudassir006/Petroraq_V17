<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_custom_purchase_rfq_tree" model="ir.ui.view">
        <field name="name">custom.purchase.rfq.tree</field>
        <field name="model">custom.purchase.rfq</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="pr_name"/>
                <field name="requisition_id"/>
                <field name="partner_id"/>
                <field name="requested_by"/>
                <field name="state" widget="badge"/>
                <field name="quotation_count"/>
            </tree>
        </field>
    </record>

    <record id="view_custom_purchase_rfq_form" model="ir.ui.view">
        <field name="name">custom.purchase.rfq.form</field>
        <field name="model">custom.purchase.rfq</field>
        <field name="arch" type="xml">
            <form string="Custom RFQ">
                <header>
                    <button name="action_send_rfq_email" type="object" string="Send RFQ Email" class="btn-primary" invisible="state != 'draft'" groups="pr_custom_purchase.procurement_admin"/>
                    <button name="action_view_quotations" type="object" string="Submitted Quotations" class="btn-primary" groups="pr_custom_purchase.procurement_admin"/>
                    <button name="action_open_rfq_comparison" type="object" string="Compare Quotations" class="btn-secondary" groups="pr_custom_purchase.procurement_admin"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,sent,done,cancel"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_quotations" type="object" class="oe_stat_button" icon="fa-list-alt">
                            <field name="quotation_count" widget="statinfo" string="Quotations"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="pr_name" readonly="1"/>
                            <field name="requisition_id" readonly="1"/>
                            <field name="partner_id"/>
                        </group>
                        <group>
                            <field name="date_request" readonly="1"/>
                            <field name="date_planned"/>
                            <field name="requested_by" readonly="1"/>
                            <field name="department" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="RFQ Lines">
                            <field name="line_ids" readonly="1">
                                <tree>
                                    <field name="name"/>
                                    <field name="type"/>
                                    <field name="cost_center_id"/>
                                    <field name="quantity"/>
                                    <field name="unit"/>
                                    <field name="price_unit"/>
                                    <field name="subtotal"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_custom_purchase_rfq" model="ir.actions.act_window">
        <field name="name">RFQs</field>
        <field name="res_model">custom.purchase.rfq</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_custom_purchase_rfq_root"
              name="RFQs"
              parent="purchase.menu_purchase_root"
              sequence="132"
              groups="pr_custom_purchase.procurement_admin,purchase.group_purchase_manager"/>

    <menuitem id="menu_custom_purchase_rfq"
              name="All RFQs"
              parent="menu_custom_purchase_rfq_root"
              action="action_custom_purchase_rfq"
              sequence="10"
              groups="pr_custom_purchase.procurement_admin,purchase.group_purchase_manager"/>
</odoo>