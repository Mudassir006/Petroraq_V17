<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_rfq_comparison_wizard_form" model="ir.ui.view">
        <field name="name">rfq.comparison.wizard.form</field>
        <field name="model">rfq.comparison.wizard</field>
        <field name="arch" type="xml">
            <form string="RFQ Comparison">
                <header>
                    <button name="action_export_xlsx" string="Export Excel" type="object" class="btn-secondary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>Line-by-Line RFQ Comparison</h1>
                        <h2>
                            <field name="custom_rfq_id" readonly="1" invisible="not custom_rfq_id"/>
                                                        <field name="requisition_id" readonly="1"/>
                        </h2>
                    </div>
                    <p string="Select one offer per product. All vendor offers are listed below." class="text-muted"/>
                    <group>
                        <field name="comparison_html" widget="html" nolabel="1" readonly="1"/>
                    </group>
                    <separator string="Detailed Selection Lines"/>
                    <div>
                        <field name="line_ids" nolabel="1">

                            <tree create="0" delete="0" decoration-success="is_best_line">
                                <field name="is_best_line"/>

                                <field name="is_selected"/>
                                <field name="product_key" column_invisible="1"/>
                                <field name="product_name"/>
                                <field name="rfq_id"/>
                                <field name="vendor_id"/>
                                <field name="quantity"/>
                                <field name="unit"/>
                                <field name="type"/>
                                <field name="cost_center_id"/>
                                <field name="unit_price"/>
                                <field name="best_badge" widget="badge" decoration-success="is_best_line"/>
                            </tree>
                        </field>
                    </div>
                </sheet>
                <footer>
                    <button name="action_create_selected_purchase_orders"
                            string="Create Purchase Orders from Selection"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_rfq_comparison_wizard" model="ir.actions.act_window">
        <field name="name">RFQ Comparison</field>
        <field name="res_model">rfq.comparison.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_rfq_comparison_wizard_form"/>
        <field name="target">current</field>
    </record>
</odoo>