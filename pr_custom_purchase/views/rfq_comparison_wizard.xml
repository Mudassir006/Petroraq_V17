<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_rfq_comparison_wizard_form" model="ir.ui.view">
        <field name="name">rfq.comparison.wizard.form</field>
        <field name="model">rfq.comparison.wizard</field>
        <field name="arch" type="xml">
            <form string="Quotation Comparison">
                <sheet>
                    <div class="oe_title">
                        <h1>Line-by-Line Quotation Comparison</h1>
                        <h2><field name="rfq_id" readonly="1"/></h2>
                    </div>
                    <group>
                        <field name="line_ids" nolabel="1">
                            <tree editable="bottom" create="0" delete="0" decoration-success="selected_vendor_id == best_vendor_id">
                                <field name="is_selected"/>
                                <field name="product_name"/>
                                <field name="quantity"/>
                                <field name="unit"/>
                                <field name="type"/>
                                <field name="cost_center_id"/>
                                <field name="best_vendor_id"/>
                                <field name="best_price"/>
                                <field name="possible_vendor_ids" invisible="1"/>
                                <field name="selected_vendor_id" domain="[('id', 'in', possible_vendor_ids)]"/>
                                <field name="selected_price"/>
                                <field name="offer_summary" readonly="1" optional="show"/>
                            </tree>
                        </field>
                    </group>
                </sheet>
                <footer>
                    <button name="action_create_selected_purchase_orders"
                            string="Create Purchase Orders from Selection"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
