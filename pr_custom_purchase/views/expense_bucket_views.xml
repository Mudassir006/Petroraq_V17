<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_pr_expense_bucket_tree" model="ir.ui.view">
        <field name="name">pr.expense.bucket.tree</field>
        <field name="model">pr.expense.bucket</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="scope"/>
                <field name="expense_type"/>
                <field name="department_id"/>
                <field name="project_id"/>
                <field name="budget_amount"/>
                <field name="cost_center_budget_total"/>
                <field name="budget_left"/>
            </tree>
        </field>
    </record>

    <record id="view_pr_expense_bucket_form" model="ir.ui.view">
        <field name="name">pr.expense.bucket.form</field>
        <field name="model">pr.expense.bucket</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="scope"/>
                            <field name="expense_type"/>
                            <field name="department_id" invisible="scope != 'department'" required="scope == 'department'"/>
                            <field name="project_id" invisible="scope != 'project'" required="scope == 'project'"/>
                        </group>
                        <group>
                            <field name="budget_amount"/>
                            <field name="cost_center_budget_total" readonly="1"/>
                            <field name="budget_left" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Cost Centers">
                            <field name="cost_center_ids">
                                <tree editable="bottom">
                                    <field name="name"/>
                                    <field name="budget_code"/>
                                    <field name="budget_type"/>
                                    <field name="budget_allowance"/>
                                    <field name="budget_left" readonly="1"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_pr_expense_bucket" model="ir.actions.act_window">
        <field name="name">Expense Buckets</field>
        <field name="res_model">pr.expense.bucket</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_pr_expense_bucket"
              name="Expense Buckets"
              parent="pr_custom_purchase.menu_purchase_requisition"
              action="action_pr_expense_bucket"
              sequence="30"/>
</odoo>
